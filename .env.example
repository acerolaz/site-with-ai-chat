# Azure AI
AZURE_AI_INFERENCE_API_KEY=remplacer-par-la-cle-fournie-par-le-formateur
AZURE_AI_INFERENCE_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1
AZURE_AI_INFERENCE_MODEL=Kimi-K2.6

# PostgreSQL
POSTGRES_USER=replacer-par-le-nom-d-utilisateur-fourni-par-le-formateur
POSTGRES_PASSWORD=replacer-par-le-mot-de-passe-fourni-par-le-formateur
POSTGRES_DB=replacer-par-le-nom-de-la-base-de-donnees-fourni-par-le-formateur
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}